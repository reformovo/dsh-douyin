{
  "name": "dsh-douyin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "摸鱼抖音：右侧边栏竖着刷抖音推荐流，等待 Agent 时一起等（a_bogus 自签名，免登录）",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/",
    "locale/*.json",
    "icon.svg",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reformovo/dsh-douyin.git"
  },
  "homepage": "https://github.com/reformovo/dsh-douyin#readme"
}
